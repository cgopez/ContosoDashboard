@using Microsoft.AspNetCore.Components.Forms
@inject IJSRuntime JS

<div class="document-upload">
    <input id="fileInput" type="file" multiple @onchange="OnFileInputChanged" />

    <div class="form-row mt-2">
        <input placeholder="Title" @bind="Title" class="form-control" />
        <select @bind="Category" class="form-control ms-2">
            <option value="">Select category</option>
            <option>Project Documents</option>
            <option>Team Resources</option>
            <option>Personal Files</option>
            <option>Reports</option>
            <option>Presentations</option>
            <option>Other</option>
        </select>
    </div>

    <button type="button" class="btn btn-primary mt-2" @onclick="UploadFiles" disabled="@(HasNoFiles)">Upload</button>

    @if (progress >= 0)
    {
        <div class="progress mt-2">
            <div class="progress-bar" role="progressbar" style="width:@progress%">@progress%</div>
        </div>
    }

    @if (statusMessages.Count > 0)
    {
        <ul class="mt-2">
            @foreach (var msg in statusMessages)
            {
                <li>@msg</li>
            }
        </ul>
    }
</div>

@code {
    private int progress = -1;
    private List<string> statusMessages = new();
    private string Title { get; set; } = string.Empty;
    private string Category { get; set; } = string.Empty;
    private bool HasNoFiles => _fileCount == 0;
    private int _fileCount = 0;

    private void OnFileInputChanged(ChangeEventArgs e)
    {
        // Update file count from the input element via JS interop
        _ = UpdateFileCountFromInput();
    }

    private async Task UpdateFileCountFromInput()
    {
        _fileCount = await JS.InvokeAsync<int>("docUpload.getFileCount", "fileInput");
        StateHasChanged();
    }

    [JSInvokable]
    public void ReportProgress(int pct)
    {
        progress = pct;
        StateHasChanged();
    }

    [JSInvokable]
    public void UploadCompleted(int status, string response)
    {
        progress = -1;
        if (status >= 200 && status < 300)
        {
            statusMessages.Add("Upload completed: " + status);
            // clear file input
            _ = JS.InvokeVoidAsync("docUpload.clearFileInput", "fileInput");
            _fileCount = 0;
        }
        else
        {
            statusMessages.Add($"Upload failed: {status} - {response}");
        }
        StateHasChanged();
    }

    private async Task UploadFiles()
    {
        statusMessages.Clear();
        progress = 0;
        StateHasChanged();

        var dotNetRef = DotNetObjectReference.Create(this);
        await JS.InvokeVoidAsync("docUpload.uploadWithProgress", ElementReferenceAccessor("fileInput"), "/api/documents", Title, Category, dotNetRef);
    }

    // Helper to pass element by id via JS (Interop accepts element references via JS; use id helper)
    private object ElementReferenceAccessor(string id) => id;
}
